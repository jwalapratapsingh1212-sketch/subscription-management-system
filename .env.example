# ============================================================================
# Subscription Management System — Environment Configuration Template
# Copy this file to `.env` and customize values for your local environment.
# NEVER commit real secrets or production credentials to version control.
# ============================================================================

# Application Settings
APP_NAME="Enterprise Subscription & Billing Management System"
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL Database Configuration
# Primary production / Docker Compose connection string:
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME_LOCAL_DEV_ONLY@localhost:5432/subscription_db
# Optional fallback when running automated tests or local dev without a live Postgres service:
FALLBACK_SQLITE_URL=sqlite:///./subscription_system.db
AUTO_FALLBACK_TO_SQLITE=true

# PostgreSQL Container Settings (for docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV_ONLY
POSTGRES_DB=subscription_db
POSTGRES_PORT=5432

# JWT & Security Settings
JWT_SECRET_KEY=REPLACE_WITH_64_BYTE_HEX_SECRET_IN_LOCAL_ENV
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend Settings
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Billing Worker Configuration
BILLING_WORKER_BATCH_SIZE=50
BILLING_WORKER_MAX_RETRIES=3
DEFAULT_PAYMENT_TERM_DAYS=14
